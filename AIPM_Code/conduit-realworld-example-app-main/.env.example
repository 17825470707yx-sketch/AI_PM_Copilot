## Backend (Node.js API)
PORT=3001
JWT_KEY=

## Frontend (Vite Dev Server)
FRONTEND_PORT=5173
BACKEND_HOST=127.0.0.1

## Development Database - SQLite (no need to install DB server)
DEV_DB_DIALECT=sqlite
DEV_DB_STORAGE=./database_dev.sqlite
DEV_DB_LOGGING=false

## Testing Database
TEST_DB_DIALECT=sqlite
TEST_DB_STORAGE=./database_test.sqlite
TEST_DB_LOGGING=false

## Production Database
PROD_DB_DIALECT=sqlite
PROD_DB_STORAGE=./database_prod.sqlite
PROD_DB_LOGGING=false
