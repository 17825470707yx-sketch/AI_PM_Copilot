# ==============================================
# AIPM 全动态端口架构统一配置模板
# 将此文件复制为 .env.local 开始使用
# ==============================================

# ------------------------------
# Node.js Ark Proxy 服务配置
# ------------------------------
ARK_PROXY_PORT=8787
ARK_PROXY_HOST=0.0.0.0

# 火山方舟 LLM 端点配置
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=your-endpoint-id
ARK_API_KEY=your-api-key

# GitHub API 配置（网络不佳时可替换为国内镜像代理）
GITHUB_API_BASE=https://api.github.com

# CORS 跨域策略
# 设置为 * 即可允许任意前端端口访问（5173, 5174, 5175...）
CORS_ORIGIN=*

# ------------------------------
# Python AI Layer 后端配置
# ------------------------------
AI_LAYER_PORT=8000
AI_LAYER_HOST=0.0.0.0

# Node.js 代理转发到 Python AI Layer 的地址
# 注意：端口部分请与上面 AI_LAYER_PORT 保持一致
AI_LAYER_BASE=http://127.0.0.1:8000

# ------------------------------
# Vite React 前端开发服务器配置
# ------------------------------
VITE_PORT=5173
